# Environment: dev | staging | prod (optional; defaults to dev)
# Use APP_ENV=production with all USE_MOCK_*=false for release builds.
APP_ENV=dev

# Android emulator: use 10.0.2.2 instead of localhost.
# Physical device: use your PC LAN IP, e.g. http://192.168.0.3:8080/api/v1
API_BASE_URL=http://10.0.2.2:8080/api/v1
WS_BASE_URL=ws://10.0.2.2:8080/ws

# Optional HTTP timeouts (seconds)
API_CONNECT_TIMEOUT_SECONDS=15
API_RECEIVE_TIMEOUT_SECONDS=30

# UI development - mock data only (no backend needed)
USE_MOCK_AUTH=true
USE_MOCK_API=true
USE_MOCK_CHAT=true
USE_MOCK_NOTIFICATIONS=true
USE_MOCK_SEARCH=true
USE_MOCK_AI=true
USE_MOCK_MAP=true

# Dev-only: full funnel every cold start / hot restart:
# Splash → Select Language → Onboarding → Auth → Startup → Home
# Turn on only when testing the entry funnel; leave false for logged-in demos.
FORCE_DEV_FUNNEL=false

# Optional narrower overrides (ignored when FORCE_DEV_FUNNEL=true for splash):
FORCE_SHOW_ONBOARDING=false
FORCE_SHOW_STARTUP=false

# Real API / production testing later:
# APP_ENV=production
# USE_MOCK_AUTH=false
# USE_MOCK_API=false
# USE_MOCK_CHAT=false
# USE_MOCK_NOTIFICATIONS=false
# USE_MOCK_SEARCH=false
# USE_MOCK_AI=false
# USE_MOCK_MAP=false
# API_BASE_URL=https://api.example.com/api/v1
# WS_BASE_URL=wss://api.example.com/ws
# FCM_ENABLED=true

# Google Maps (Android): set in android/local.properties (gitignored):
# GOOGLE_MAPS_API_KEY=your_maps_sdk_key_here
# Or export GOOGLE_MAPS_API_KEY in CI. Do not commit the key in AndroidManifest.
#
# Google Maps (iOS): copy ios/Flutter/Secrets.xcconfig.example → Secrets.xcconfig
# and set GOOGLE_MAPS_API_KEY there (gitignored).

# Google UI chooser is always on; set true when live OAuth provider is wired.
ENABLE_GOOGLE_AUTH=true

FCM_ENABLED=false
# Optional dev token for POST /notifications/devices when Firebase is not configured.
FCM_DEBUG_TOKEN=
