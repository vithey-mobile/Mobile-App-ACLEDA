# --- DeepSeek / LLM ---------------------------------------------------------
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Model behaviour ----------------------------------------------------------
# TEMPERATURE=0.2
# MAX_TOKENS=3000
# TIMEOUT_SECONDS=30

# --- Reliability -----------------------------------------------------------------
# Extra attempts for transient API failures (total tries = MAX_RETRIES + 1)
# MAX_RETRIES=2
# RETRY_BACKOFF_SECONDS=1.0

# --- Cost protection (library-level rate limiting) ---------------------------------
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_CALLS=120
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Input guards --------------------------------------------------------------------
# MAX_POSTS_PER_BUILD=100
# MAX_CONTENT_CHARS=6000

# --- Cache ------------------------------------------------------------------------------
# CACHE_ENABLED=true
# CACHE_MAX_SIZE=512

# --- Logging --------------------------------------------------------------------------------
# LOG_LEVEL=INFO

# --- HTTP API (only used by `python main.py serve`) --------------------------------------------
# API_RATE_LIMIT_PER_MINUTE=30
# API_MAX_BODY_BYTES=524288
# API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
