SERVER_PORT=8089
SPRING_PROFILES_ACTIVE=docker
CONFIG_SERVER_URL=http://config-server:8888
EUREKA_CLIENT_ENABLED=true
EUREKA_URL=http://eureka-server:8761/eureka/

AI_DB_URL=jdbc:postgresql://postgres:5432/ai_db
AI_DB_USERNAME=postgres
AI_DB_PASSWORD=postgres

VITHEY_JWT_SECRET=change-me-to-a-strong-256-bit-secret-for-local-dev

# Demo Profile M (plan.md): stub chat — no GDCE
VITHEY_AI_CHAT_MODE=stub
# Compose demo (ai-core service on vithey-network). Host-run override:
# AI_CORE_BASE_URL=http://host.docker.internal:8100
AI_CORE_BASE_URL=http://ai-core:8100
AI_CORE_TIMEOUT_SECONDS=60
USER_PROFILE_BASE_URL=http://user-profile-service:8082
CONTENT_BASE_URL=http://content-service:8084
AI_CV_MAX_POSTS=20
AI_CV_MAX_CONCURRENT=3

# Intentionally invalid — general mode is off for demo
GENERAL_SERVICE_URL=http://127.0.0.1:9
GENERAL_TIMEOUT_SECONDS=5
GENERAL_TOP_K=10
