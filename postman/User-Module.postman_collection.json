{
  "info": {
    "_postman_id": "a8f3c1e2-7b4d-4e9a-9c21-user-module-001",
    "name": "Vithey — User Module (user-profile-service)",
    "description": "Postman collection for all user-profile-service endpoints under `/api/v1/users/**`.\n\n**How to use**\n1. Import `User-Module.postman_collection.json` and `Vithey-Local.postman_environment.json`.\n2. Select environment **Vithey Local** (top-right dropdown).\n3. Set `email_or_phone` and `password` to a real account (Environment → Edit).\n4. Run **Auth → Login** first — it saves `access_token` and `user_id` automatically.\n5. Run the User Profile / Settings / Search requests.\n\n**Base URL**\n- Gateway (recommended): `http://localhost:8080` → keep `base_url` as-is\n- Direct user-profile-service: set `base_url` to `{{user_service_url}}` (`http://localhost:8082`)\n\nAll business endpoints require `Authorization: Bearer <access_token>`.\nRequest/response bodies use snake_case.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "other_user_id",
      "value": "00000000-0000-0000-0000-000000000001"
    },
    {
      "key": "avatar_file_id",
      "value": "00000000-0000-0000-0000-000000000002"
    },
    {
      "key": "email_or_phone",
      "value": "student@example.com"
    },
    {
      "key": "password",
      "value": "Password123!"
    },
    {
      "key": "search",
      "value": "Jane"
    },
    {
      "key": "page",
      "value": "1"
    },
    {
      "key": "limit",
      "value": "20"
    }
  ],
  "item": [
    {
      "name": "Auth (get token)",
      "description": "Helper requests to obtain a JWT before testing the user module. Login has no bearer auth.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const data = json && json.data;",
                  "function setVar(key, value) {",
                  "  pm.collectionVariables.set(key, value);",
                  "  if (pm.environment && pm.environment.name) {",
                  "    pm.environment.set(key, value);",
                  "  }",
                  "}",
                  "if (data && data.tokens && data.tokens.access_token) {",
                  "  setVar('access_token', data.tokens.access_token);",
                  "}",
                  "if (data && data.tokens && data.tokens.refresh_token) {",
                  "  setVar('refresh_token', data.tokens.refresh_token);",
                  "}",
                  "if (data && data.user && data.user.user_id) {",
                  "  setVar('user_id', data.user.user_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email_or_phone\": \"{{email_or_phone}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticate and store `access_token`, `refresh_token`, and `user_id` into collection variables."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Profile",
      "description": "Profile endpoints owned by user-profile-service.",
      "item": [
        {
          "name": "Get my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get me returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.user_id) {",
                  "  pm.collectionVariables.set('user_id', json.data.user_id);",
                  "  if (pm.environment && pm.environment.name) {",
                  "    pm.environment.set('user_id', json.data.user_id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Returns the authenticated user's profile plus language/theme summary.\n\nResponse fields: `user_id`, `full_name`, `bio`, `avatar_url`, `telegram_link`, `facebook_link`, `university`, `major`, `graduation_year`, `language`, `theme`."
          },
          "response": []
        },
        {
          "name": "Get public profile by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get public profile returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/{{other_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "{{other_user_id}}"]
            },
            "description": "Public profile for `{userId}` (UUID). Replace `other_user_id` with a real user UUID, or use `{{user_id}}` after login to fetch your own public view."
          },
          "response": []
        },
        {
          "name": "Update my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Update profile returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Jane Doe\",\n  \"bio\": \"AUB CS student\",\n  \"telegram_link\": \"https://t.me/jane\",\n  \"facebook_link\": \"https://facebook.com/jane\",\n  \"university\": \"AUB\",\n  \"major\": \"Computer Science\",\n  \"graduation_year\": 2026\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Partial update of the current user's profile. All fields are optional.\n\nConstraints:\n- `full_name`, `university`, `major` ≤ 160\n- `bio` ≤ 2000\n- `telegram_link`, `facebook_link` ≤ 500\n- `graduation_year` 1900–2100"
          },
          "response": []
        },
        {
          "name": "Update my avatar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Update avatar returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avatar_file_id\": \"{{avatar_file_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me/avatar",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me", "avatar"]
            },
            "description": "Sets avatar from an uploaded file id (from file-service). `avatar_file_id` is required (UUID).\n\nUpload a file first via file-service, then paste the returned file id into the `avatar_file_id` collection variable."
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Settings",
      "description": "Settings endpoints owned by user-profile-service.",
      "item": [
        {
          "name": "Get my settings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get settings returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/me/settings",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me", "settings"]
            },
            "description": "Returns current user settings: `language` (`km`|`en`), `theme` (`light`|`dark`|`system`), `notifications`, `privacy`, `fcm_token`."
          },
          "response": []
        },
        {
          "name": "Update my settings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Update settings returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"km\",\n  \"theme\": \"dark\",\n  \"notifications\": {\n    \"likes\": true,\n    \"comments\": true,\n    \"chat\": true,\n    \"payments\": true\n  },\n  \"privacy\": {\n    \"profile_visible\": true,\n    \"show_activity\": true\n  },\n  \"fcm_token\": \"optional-device-token\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/users/me/settings",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "me", "settings"]
            },
            "description": "Partial update of settings / FCM token. All fields optional.\n\n- `language`: `km` | `en`\n- `theme`: `light` | `dark` | `system`\n- `fcm_token` ≤ 512"
          },
          "response": []
        }
      ]
    },
    {
      "name": "User Search",
      "description": "Search users for chat/mentions.",
      "item": [
        {
          "name": "Search users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Search users returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json && Array.isArray(json.data) && json.data.length > 0 && json.data[0].user_id) {",
                  "  pm.collectionVariables.set('other_user_id', json.data[0].user_id);",
                  "  if (pm.environment && pm.environment.name) {",
                  "    pm.environment.set('other_user_id', json.data[0].user_id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/users/search?search={{search}}&page={{page}}&limit={{limit}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "users", "search"],
              "query": [
                {
                  "key": "search",
                  "value": "{{search}}",
                  "description": "Required. ILIKE match on full_name"
                },
                {
                  "key": "page",
                  "value": "{{page}}",
                  "description": "Default 1"
                },
                {
                  "key": "limit",
                  "value": "{{limit}}",
                  "description": "Default 20"
                }
              ]
            },
            "description": "Search users by `full_name`. On success, the first hit is saved to `other_user_id` for use with Get public profile."
          },
          "response": []
        }
      ]
    }
  ]
}
